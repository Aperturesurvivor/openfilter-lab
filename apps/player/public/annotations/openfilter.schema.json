{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openfilter.local/schema/v0.1",
  "title": "OpenFilter Annotation",
  "type": "object",
  "required": ["schema", "annotationId", "title", "license", "createdAt", "media", "coverage", "events"],
  "properties": {
    "schema": { "const": "https://openfilter.local/schema/v0.1" },
    "annotationId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "minLength": 1 },
    "media": {
      "type": "object",
      "required": ["title", "year", "edition", "runtimeMs", "sourceUrl", "fingerprints"],
      "properties": {
        "title": { "type": "string" },
        "year": { "type": ["integer", "null"] },
        "edition": { "type": "string" },
        "runtimeMs": { "type": "integer", "minimum": 1 },
        "sourceUrl": { "type": "string" },
        "fingerprints": {
          "type": "object",
          "required": ["sourceId", "durationMs", "chapterStartsMs"],
          "properties": {
            "sourceId": { "type": "string" },
            "durationMs": { "type": "integer", "minimum": 1 },
            "chapterStartsMs": {
              "type": "array",
              "items": { "type": "integer", "minimum": 0 }
            },
            "subtitleHash": { "type": "string" },
            "videoHash": { "type": "string" },
            "audioHash": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "reviewed", "reviewer"],
        "properties": {
          "category": { "$ref": "#/$defs/category" },
          "reviewed": { "type": "boolean" },
          "reviewer": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "category": {
      "enum": ["language", "blasphemy", "sexual-content", "violence", "substance-use"]
    },
    "action": {
      "enum": ["mute", "skip", "blank"]
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "startMs",
        "endMs",
        "category",
        "severity",
        "defaultAction",
        "tags",
        "note",
        "confidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "startMs": { "type": "integer", "minimum": 0 },
        "endMs": { "type": "integer", "minimum": 1 },
        "category": { "$ref": "#/$defs/category" },
        "severity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "defaultAction": { "$ref": "#/$defs/action" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "note": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": {
          "enum": ["human", "subtitle", "transcript", "vision", "audio", "imported", "fixture"]
        }
      },
      "additionalProperties": false
    }
  }
}
